---
interface Props {
  en: string;
  zh: string;
  as?: "span" | "p" | "strong" | "em" | "small" | "h1" | "h2" | "h3" | "blockquote";
  class?: string;
  id?: string;
}

const { en, zh, as: Tag = "span", class: className, id } = Astro.props;
---

<Tag {id} class={className} data-copy data-en={en} data-zh={zh}>{en}</Tag>
