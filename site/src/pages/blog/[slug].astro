---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import ReferenceLayout from "../../layouts/ReferenceLayout.astro";
import Copy from "../../components/Copy.astro";

interface Props {
  en: CollectionEntry<"blog">;
  zh: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const entries = await getCollection("blog");
  const englishPosts = entries
    .filter(
      (entry) =>
        entry.data.locale === "en" && entry.data.status === "published",
    )
    .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));

  return englishPosts.map((en) => {
    const zh = entries.find(
      (entry) =>
        entry.data.locale === "zh" && entry.data.page === en.data.page,
    );

    if (!zh) {
      throw new Error(`Missing Chinese blog entry for ${en.data.page}`);
    }

    return {
      params: { slug: en.data.page },
      props: { en, zh },
    };
  });
}

const { en, zh } = Astro.props as Props;
const {
  Content: EnglishContent,
  headings: englishHeadings,
} = await render(en);
const {
  Content: ChineseContent,
  headings: chineseHeadings,
} = await render(zh);

const englishSections = englishHeadings.filter((heading) => heading.depth === 2);
const chineseSections = chineseHeadings.filter((heading) => heading.depth === 2);
const toc = englishSections.map((heading, index) => ({
  idEn: heading.slug,
  idZh: chineseSections[index]?.slug ?? heading.slug,
  en: heading.text,
  zh: chineseSections[index]?.text ?? heading.text,
}));
---

<ReferenceLayout
  title={`${en.data.title} — EvoPolicyGym Blog`}
  description={en.data.description}
  area="blog"
  current={en.data.page}
  {toc}
>
  <header>
    <p class="reference-kicker">
      <time datetime={en.data.publishedAt}>{en.data.publishedAt}</time>
      {" · "}
      <span>{en.data.author}</span>
    </p>
    <Copy en={en.data.title} zh={zh.data.title} as="h1" />
    <Copy
      class="reference-lead"
      en={en.data.lead}
      zh={zh.data.lead}
      as="p"
    />
  </header>

  <div class="content-markdown">
    <div data-lang-view="en">
      <EnglishContent />
    </div>
    <div data-lang-view="zh" hidden>
      <ChineseContent />
    </div>
  </div>
</ReferenceLayout>
