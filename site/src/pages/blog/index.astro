---
import { getCollection } from "astro:content";
import ReferenceLayout from "../../layouts/ReferenceLayout.astro";
import Copy from "../../components/Copy.astro";
import { withBase } from "../../lib/paths";

const entries = await getCollection("blog");
const posts = entries
  .filter(
    (entry) =>
      entry.data.locale === "en" && entry.data.status === "published",
  )
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt))
  .map((en) => {
    const zh = entries.find(
      (entry) =>
        entry.data.locale === "zh" && entry.data.page === en.data.page,
    );

    if (!zh) {
      throw new Error(`Missing Chinese blog entry for ${en.data.page}`);
    }

    return { en, zh };
  });

const toc = [
  { id: "posts", en: "Posts", zh: "文章" },
];
---

<ReferenceLayout
  title="Blog — EvoPolicyGym"
  description="Dated project updates, engineering notes, Benchmark integration reports, and experiment retrospectives from EvoPolicyGym."
  area="blog"
  current="blog"
  {toc}
>
  <header>
    <Copy en="Blog" zh="博客" as="h1" />
    <Copy
      class="reference-lead"
      en="Project updates, engineering decisions, Benchmark integrations, and experiment retrospectives."
      zh="项目更新、工程决策、Benchmark 集成与实验复盘。"
      as="p"
    />
  </header>

  <section id="posts">
    <Copy en="Posts" zh="文章" as="h2" />
    <div class="blog-list">
      {posts.map(({ en, zh }) => (
        <article>
          <time datetime={en.data.publishedAt}>{en.data.publishedAt}</time>
          <div>
            <h3>
              <a href={withBase(`blog/${en.data.page}/`)}>
                <Copy en={en.data.title} zh={zh.data.title} />
              </a>
            </h3>
            <Copy en={en.data.description} zh={zh.data.description} as="p" />
            <div class="blog-tags">
              {en.data.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

</ReferenceLayout>
