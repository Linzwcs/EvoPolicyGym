---
import ReferenceLayout from "../../../../../layouts/ReferenceLayout.astro";
import Copy from "../../../../../components/Copy.astro";
import { withBase } from "../../../../../lib/paths";

const toc = [
  { id: "overview", en: "Overview", zh: "概述" },
  { id: "task", en: "Task", zh: "任务" },
  { id: "policy-contract", en: "Policy contract", zh: "Policy 契约" },
  { id: "episode", en: "Episode lifecycle", zh: "Episode 生命周期" },
  { id: "scoring", en: "Reward and score", zh: "Reward 与评分" },
  { id: "feedback", en: "Feedback and trace", zh: "Feedback 与 trace" },
  { id: "running", en: "Install and evaluate", zh: "安装与评估" },
  { id: "provenance", en: "Provenance", zh: "来源" },
];
---

<ReferenceLayout
  title="CartPole-v1 Benchmark — EvoPolicyGym Documentation"
  description="The complete Policy-visible and scoring contract for the EvoPolicyGym CartPole-v1 Benchmark."
  area="environments"
  current="cartpole"
  {toc}
>
  <nav class="reference-breadcrumbs" aria-label="Breadcrumb">
    <a href={withBase("environments/")}><Copy en="Environment collection" zh="环境目录" /></a>
    <span aria-hidden="true">/</span>
    <span>Gymnasium</span>
    <span aria-hidden="true">/</span>
    <span>Classic Control</span>
    <span aria-hidden="true">/</span>
    <span aria-current="page">CartPole</span>
  </nav>

  <header>
    <p class="reference-kicker">
      <Copy en="Reference environment · current distribution" zh="参考环境 · 当前 distribution" />
    </p>
    <Copy en="CartPole-v1" zh="CartPole-v1" as="h1" />
    <Copy
      class="reference-lead"
      en="Balance an upright pole by moving its cart left or right. The Benchmark evaluates how long a Policy remains within the valid physical state."
      zh="通过左右推动小车来保持杆竖直。Benchmark 评估 Policy 能让系统在有效物理状态内维持多长时间。"
      as="p"
    />
  </header>

  <section id="overview">
    <Copy en="Overview" zh="概述" as="h2" />
    <Copy
      en="CartPole is the minimal reference for an independently installable EvoPolicyGym Benchmark. It exercises the public authoring interface and the complete Evaluation lifecycle while remaining outside the base wheel."
      zh="CartPole 是 EvoPolicyGym 独立 Benchmark distribution 的最小参考实现。它覆盖公共 authoring 接口与完整 Evaluation 生命周期，但不包含在基础 wheel 中。"
      as="p"
    />
    <dl class="reference-definition">
      <dt><Copy en="Package" zh="Package" /></dt>
      <dd><code>evopolicygym-benchmark-cartpole==0.1.0</code></dd>
      <dt><Copy en="Import" zh="Import" /></dt>
      <dd><code>cartpole</code></dd>
      <dt><Copy en="Benchmark ID" zh="Benchmark ID" /></dt>
      <dd><code>gymnasium/CartPole-v1/mean-return-v1</code></dd>
      <dt><Copy en="Provider" zh="Provider" /></dt>
      <dd>Gymnasium · Classic Control · <code>CartPole-v1</code></dd>
      <dt><Copy en="Splits" zh="Splits" /></dt>
      <dd><code>train</code>, <code>validation</code>, <code>test</code></dd>
      <dt><Copy en="Direction" zh="优化方向" /></dt>
      <dd><Copy en="Maximize mean Episode return" zh="最大化 Episode 平均回报" /></dd>
    </dl>
  </section>

  <section id="task">
    <Copy en="Task" zh="任务" as="h2" />
    <Copy
      en="A pole is attached to a cart by an unactuated joint. At every step the Policy chooses one of two fixed horizontal forces. A good Policy moves the cart underneath the falling pole early enough to keep both the pole angle and cart position inside their termination limits."
      zh="一根杆通过无驱动关节连接在小车上。每一步中，Policy 从两个固定的水平力中选择一个。好的 Policy 会及时把小车移动到倾倒中的杆下方，使杆角度与小车位置都保持在终止阈值以内。"
      as="p"
    />
    <Copy
      en="There is no separate success event. A normal Episode succeeds by surviving until the 500-step time limit."
      zh="这个任务没有单独的成功事件；正常 Episode 通过坚持到 500 步时限而完成。"
      as="p"
    />
  </section>

  <section id="policy-contract">
    <Copy en="Policy-visible contract" zh="Policy 可见契约" as="h2" />
    <Copy
      en="Policy.act() receives one ordered Python list containing exactly four floats. The order is part of the Benchmark contract; field names are explanatory and are not included in the runtime value."
      zh="Policy.act() 接收一个严格包含 4 个浮点数的有序 Python list。顺序属于 Benchmark 契约的一部分；下列字段名仅用于说明，并不会出现在运行时值中。"
      as="p"
    />

    <table class="reference-table">
      <thead>
        <tr>
          <th><Copy en="Index" zh="索引" /></th>
          <th><Copy en="Component" zh="分量" /></th>
          <th><Copy en="Meaning" zh="含义" /></th>
          <th><Copy en="Observation bound" zh="Observation 范围" /></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>0</code></td>
          <td><code>cart_position</code></td>
          <td><Copy en="Horizontal cart position" zh="小车的水平位置" /></td>
          <td><code>[-4.8, 4.8]</code></td>
        </tr>
        <tr>
          <td><code>1</code></td>
          <td><code>cart_velocity</code></td>
          <td><Copy en="Horizontal cart velocity" zh="小车的水平速度" /></td>
          <td><Copy en="Unbounded" zh="无界" /></td>
        </tr>
        <tr>
          <td><code>2</code></td>
          <td><code>pole_angle</code></td>
          <td><Copy en="Pole angle in radians; 0 is upright" zh="杆的弧度角；0 表示竖直" /></td>
          <td><Copy en="Approximately [-0.418, 0.418]" zh="约 [-0.418, 0.418]" /></td>
        </tr>
        <tr>
          <td><code>3</code></td>
          <td><code>pole_angular_velocity</code></td>
          <td><Copy en="Pole angular velocity" zh="杆的角速度" /></td>
          <td><Copy en="Unbounded" zh="无界" /></td>
        </tr>
      </tbody>
    </table>

    <Copy en="A representative value has this shape:" zh="一个具有代表性的值如下：" as="p" />
    <pre><code>[0.012, -0.031, 0.006, 0.042]</code></pre>

    <Copy
      en="The Policy returns one exact integer. Boolean values, floats, strings, containers, and all integers outside the set below are invalid."
      zh="Policy 返回一个精确整数。布尔值、浮点数、字符串、容器以及集合之外的整数均为非法 Action。"
      as="p"
    />
    <table class="reference-table">
      <thead>
        <tr>
          <th><Copy en="Action" zh="Action" /></th>
          <th><Copy en="Meaning" zh="含义" /></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>0</code></td>
          <td><Copy en="Push the cart left" zh="向左推动小车" /></td>
        </tr>
        <tr>
          <td><code>1</code></td>
          <td><Copy en="Push the cart right" zh="向右推动小车" /></td>
        </tr>
      </tbody>
    </table>

    <div class="reference-note is-warning">
      <strong><Copy en="Strict Action handling" zh="严格 Action 处理" /></strong>
      <Copy
        en="Invalid Actions are never clipped, converted, repaired, or replaced. They end the Policy's Episode before another Environment step is taken."
        zh="非法 Action 不会被截断、转换、修复或替换；它会在下一次 Environment step 发生之前终止该 Policy 的 Episode。"
        as="p"
      />
    </div>
  </section>

  <section id="episode">
    <Copy en="Episode lifecycle" zh="Episode 生命周期" as="h2" />
    <ol>
      <li><Copy en="The Benchmark derives a deterministic, split-scoped Environment seed from the public Evaluation seed and Episode index." zh="Benchmark 根据公开 Evaluation seed 与 Episode 索引，派生一个确定且按 split 隔离的 Environment seed。" /></li>
      <li><Copy en="A fresh Gymnasium CartPole instance and a fresh Policy process, instance, and scratch directory are created for the Episode." zh="该 Episode 会获得新的 Gymnasium CartPole 实例，以及新的 Policy process、实例与 scratch 目录。" /></li>
      <li><Copy en="The initial four components are sampled uniformly from (-0.05, 0.05), then exposed only as the ordered observation list." zh="初始的 4 个分量从 (-0.05, 0.05) 均匀采样，随后只以有序 observation list 的形式暴露。" /></li>
      <li><Copy en="Policy state may persist across act() calls inside this Episode, but never crosses into another Episode." zh="Policy 状态可以在同一个 Episode 的多次 act() 调用之间保留，但不会跨越 Episode。" /></li>
    </ol>

    <Copy en="The Episode ends when any of these conditions occurs:" zh="满足以下任一条件时 Episode 结束：" as="p" />
    <ul>
      <li><Copy en="the pole angle leaves approximately [-0.2095, 0.2095] radians (±12°);" zh="杆角度离开约 [-0.2095, 0.2095] 弧度（±12°）范围；" /></li>
      <li><Copy en="the cart position leaves (-2.4, 2.4);" zh="小车位置离开 (-2.4, 2.4) 范围；" /></li>
      <li><Copy en="the 500-step time limit is reached; or" zh="到达 500 步时限；或" /></li>
      <li><Copy en="the Policy fails, times out, or returns an invalid Action." zh="Policy 失败、超时或返回非法 Action。" /></li>
    </ul>
    <Copy
      en="Environment seeds are execution inputs. They are not visible to the Policy and are not published in Feedback or trace artifacts."
      zh="Environment seed 属于执行输入；Policy 无法看到它，Feedback 与 trace artifact 也不会发布它。"
      as="p"
    />
  </section>

  <section id="scoring">
    <Copy en="Reward and score" zh="Reward 与评分" as="h2" />
    <Copy
      en="CartPole separates the immediate Environment reward from the final Benchmark score:"
      zh="CartPole 会区分即时 Environment reward 与最终 Benchmark score："
      as="p"
    />
    <table class="reference-table">
      <thead>
        <tr>
          <th><Copy en="Quantity" zh="量" /></th>
          <th><Copy en="Definition" zh="定义" /></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><Copy en="Step reward" zh="Step reward" /></td>
          <td><Copy en="+1 for every Environment step, including the terminal step" zh="每次 Environment step 得 +1，包括终止 step" /></td>
        </tr>
        <tr>
          <td><Copy en="Episode return" zh="Episode return" /></td>
          <td><Copy en="Sum of step rewards; a completed Episode ranges from 1 to 500" zh="所有 step reward 之和；完整 Episode 的范围为 1 至 500" /></td>
        </tr>
        <tr>
          <td><Copy en="Policy-failure contribution" zh="Policy failure 计分" /></td>
          <td><Copy en="0, regardless of partial reward collected before failure" zh="计为 0，不保留失败前已经获得的部分 reward" /></td>
        </tr>
        <tr>
          <td><Copy en="Benchmark score" zh="Benchmark score" /></td>
          <td><Copy en="Arithmetic mean of the Episode contributions" zh="所有 Episode 计分值的算术平均数" /></td>
        </tr>
      </tbody>
    </table>
    <Copy
      en="The score direction is maximize. A score of 500 means every evaluated Episode survived the full horizon."
      zh="优化方向为 maximize。得分 500 表示所有参与评估的 Episode 都坚持到了完整时域。"
      as="p"
    />
  </section>

  <section id="feedback">
    <Copy en="Feedback and trace" zh="Feedback 与 trace" as="h2" />
    <Copy
      en="Feedback contains the scalar score and a compact public summary. These fields are intended for both human inspection and Coding Agent iteration:"
      zh="Feedback 包含标量 score 与紧凑的公开摘要。下列字段同时供人类检查与 Coding Agent 迭代使用："
      as="p"
    />
    <table class="reference-table">
      <thead>
        <tr>
          <th><Copy en="Field" zh="字段" /></th>
          <th><Copy en="Meaning" zh="含义" /></th>
        </tr>
      </thead>
      <tbody>
        <tr><td><code>summary</code></td><td><Copy en="Human-readable mean and Episode count" zh="人类可读的平均分与 Episode 数量" /></td></tr>
        <tr><td><code>mean_return</code></td><td><Copy en="The exact Benchmark score" zh="精确的 Benchmark score" /></td></tr>
        <tr><td><code>episodes</code></td><td><Copy en="Number of evaluated Episodes" zh="参与评估的 Episode 数量" /></td></tr>
        <tr><td><code>policy_failures</code></td><td><Copy en="Episodes that ended through Policy failure" zh="因 Policy failure 结束的 Episode 数量" /></td></tr>
        <tr><td><code>traced_episodes</code></td><td><Copy en="Episodes included in trace.jsonl" zh="写入 trace.jsonl 的 Episode 数量" /></td></tr>
        <tr><td><code>trace_episodes_omitted</code></td><td><Copy en="Episodes omitted to keep publication bounded" zh="为限制发布规模而省略的 Episode 数量" /></td></tr>
      </tbody>
    </table>

    <Copy
      en="The trace.jsonl artifact records at most eight Episodes. Each transition preserves the actual observation sent to the Policy, its unmodified Action, reward, next observation, and termination flags. Episode records contain status, steps, return, and any public failure classification."
      zh="trace.jsonl artifact 最多记录 8 个 Episode。每条 transition 保留实际传给 Policy 的 observation、未经修改的 Action、reward、next observation 与终止标志；Episode 记录包含状态、步数、回报和可公开的失败分类。"
      as="p"
    />
    <div class="reference-note">
      <strong><Copy en="Publication boundary" zh="发布边界" /></strong>
      <Copy
        en="Environment seeds, Policy seeds, private scenarios, Host paths, credentials, and runtime evidence are not published."
        zh="Environment seed、Policy seed、私有 scenario、Host 路径、凭证与 runtime evidence 均不会被发布。"
        as="p"
      />
    </div>
  </section>

  <section id="running">
    <Copy en="Install and evaluate" zh="安装与评估" as="h2" />
    <Copy en="Prepare the independent distribution from the repository root:" zh="在仓库根目录准备这个独立 distribution：" as="p" />
    <pre><code>uv sync --project environments/gymnasium/classic_control/cartpole --extra dev</code></pre>

    <Copy en="Evaluate the packaged baseline through the public Python API:" zh="通过公共 Python API 评估 package 内的 baseline：" as="p" />
    <pre><code>from cartpole import CartPoleBenchmark, baseline_program
from evopolicygym import EvaluationConfig, evaluate
from evopolicygym.execution import ProcessExecution

result = evaluate(
    baseline_program(),
    CartPoleBenchmark(),
    execution=ProcessExecution.unsafe(),
    config=EvaluationConfig(
        split="validation",
        episodes=5,
        seed=42,
    ),
)

print(result.feedback.score)
print(result.feedback.content)</code></pre>

    <div class="reference-note is-warning">
      <strong><Copy en="Local execution is not a sandbox" zh="本地执行不是 sandbox" /></strong>
      <Copy
        en="ProcessExecution.unsafe() runs trusted Policy code with the current user's authority. Its name is an explicit acknowledgement, not an isolation boundary."
        zh="ProcessExecution.unsafe() 会以当前用户权限执行受信任的 Policy 代码。这个名称只是显式风险确认，并不提供隔离边界。"
        as="p"
      />
    </div>
  </section>

  <section id="provenance">
    <Copy en="Provenance" zh="来源" as="h2" />
    <Copy
      en="The Benchmark adapter is maintained in this repository. Its dynamics and task definition come from Gymnasium CartPole-v1; the installed distribution accepts Gymnasium 1.2.x and 1.3.x under its current dependency range."
      zh="Benchmark adapter 由本仓库维护；动力学与任务定义来自 Gymnasium CartPole-v1。按照当前依赖范围，已安装 distribution 接受 Gymnasium 1.2.x 与 1.3.x。"
      as="p"
    />
    <p class="reference-actions">
      <a href="https://github.com/Linzwcs/EvoPolicyGym/tree/main/environments/gymnasium/classic_control/cartpole" target="_blank" rel="noreferrer">
        <Copy en="Benchmark source ↗" zh="Benchmark 源码 ↗" />
      </a>
      <a href="https://gymnasium.farama.org/environments/classic_control/cart_pole/" target="_blank" rel="noreferrer">
        <Copy en="Gymnasium task reference ↗" zh="Gymnasium 任务参考 ↗" />
      </a>
      <a href={withBase("docs/authoring/")}>
        <Copy en="Authoring contract →" zh="Authoring 契约 →" />
      </a>
    </p>
  </section>
</ReferenceLayout>
