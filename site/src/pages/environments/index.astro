---
import ReferenceLayout from "../../layouts/ReferenceLayout.astro";
import Copy from "../../components/Copy.astro";
import { withBase } from "../../lib/paths";

type LocalizedText = {
  en: string;
  zh: string;
};

type EnvironmentEntry = {
  name: string;
  benchmark: string;
  packageName: string;
  sourcePath: string;
  contractPath?: string;
  observation: LocalizedText;
  action: LocalizedText;
  horizon: string;
  score: LocalizedText;
  configuration: LocalizedText;
};

type EnvironmentSuite = {
  id: string;
  name: string;
  directory: string;
  summary: LocalizedText;
  environments: EnvironmentEntry[];
};

const fixedTask: LocalizedText = {
  en: "Fixed standard task",
  zh: "固定标准任务",
};

const suites: EnvironmentSuite[] = [
