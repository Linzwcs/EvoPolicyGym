---
import ReferenceLayout from "../../layouts/ReferenceLayout.astro";
import Copy from "../../components/Copy.astro";
import {
  environmentCollections,
  environmentDistributionCount,
  environmentDomains,
  environmentEcosystemCount,
  environmentTaskProfileCount,
  type EnvironmentCollection,
} from "../../data/environmentCatalog";
import { withBase } from "../../lib/paths";

interface CatalogSection {
  id: string;
  title: { en: string; zh: string };
  lead: { en: string; zh: string };
  ecosystems: string[];
}

const catalogSections: CatalogSection[] = [
  {
    id: "gymnasium",
    title: { en: "Gymnasium", zh: "Gymnasium" },
    lead: {
      en: "The four standard built-in suites, from compact discrete tasks to continuous physics and locomotion.",
      zh: "覆盖四个标准内置 suite，从紧凑离散任务延伸到连续物理与运动控制。",
    },
    ecosystems: ["Gymnasium"],
  },
  {
    id: "minigrid",
    title: { en: "MiniGrid", zh: "MiniGrid" },
    lead: {
      en: "Grid navigation, memory, procedural generation, and language-conditioned missions.",
      zh: "覆盖网格导航、记忆、程序化生成与语言条件任务。",
    },
    ecosystems: ["MiniGrid"],
  },
  {
    id: "interactive-planning",
    title: { en: "Planning challenges", zh: "规划挑战" },
    lead: {
      en: "Long-horizon state tracking, constraint management, constructive routing, and replanning from authoritative challenge tasks.",
      zh: "来自权威挑战任务的长时程状态跟踪、约束管理、构造式路径规划与重规划。",
    },
    ecosystems: ["AtCoder", "CodeChef"],
  },
  {
    id: "robotics",
    title: { en: "Robotics collections", zh: "机器人集合" },
    lead: {
      en: "Goal-conditioned and multi-task manipulation from Gymnasium-Robotics and MetaWorld.",
      zh: "来自 Gymnasium-Robotics 与 MetaWorld 的目标条件和多任务操作环境。",
    },
    ecosystems: ["Gymnasium-Robotics", "MetaWorld"],
  },
  {
    id: "simulation-games",
    title: {
      en: "Interactive simulation and games",
      zh: "交互模拟与游戏",
    },
    lead: {
      en: "Driving, first-person control, arcade play, and long-horizon strategy across five upstream ecosystems.",
      zh: "覆盖五个上游生态的驾驶、第一人称控制、街机玩法与长时程策略。",
    },
    ecosystems: ["HighwayEnv", "ALE", "ViZDoom", "Stable-Retro", "Jackdaw"],
  },
];

const collectionsFor = (section: CatalogSection) =>
  environmentCollections.filter((collection) =>
    section.ecosystems.includes(collection.ecosystem)
  );

const domainTaskProfileCount = (
  domain: (typeof environmentDomains)[number]["id"],
) =>
  environmentCollections
    .filter((collection) => collection.domain === domain)
    .reduce((total, collection) => total + collection.taskProfiles, 0);

const sourceUrl = (collection: EnvironmentCollection) =>
  `https://github.com/Linzwcs/EvoPolicyGym/tree/main/${collection.sourcePath}`;

const toc = [
  { id: "coverage", en: "Coverage", zh: "覆盖范围" },
  ...catalogSections.map((section) => ({
    id: section.id,
    en: section.title.en,
    zh: section.title.zh,
  })),
  { id: "using", en: "Using a distribution", zh: "使用 distribution" },
  { id: "authoring", en: "Authoring", zh: "编写环境" },
];
---

<ReferenceLayout
  title="Environment Collection — EvoPolicyGym Documentation"
  description="EvoPolicyGym Benchmark distributions across control, planning, robotics, driving, and interactive game ecosystems."
  area="environments"
  current="environments"
  {toc}
>
  <header>
    <Copy en="Environment collection" zh="环境目录" as="h1" />
    <Copy
      class="reference-lead"
      en={`${environmentDistributionCount} independently installable Benchmark distributions expose at least ${environmentTaskProfileCount} named tasks and profiles across ${environmentEcosystemCount} upstream ecosystems.`}
      zh={`${environmentDistributionCount} 个可独立安装的 Benchmark distributions，在 ${environmentEcosystemCount} 个上游生态中提供至少 ${environmentTaskProfileCount} 个具名任务与 profiles。`}
      as="p"
    />
  </header>

  <section id="coverage">
    <Copy en="Coverage" zh="覆盖范围" as="h2" />

    <dl class="environment-metrics">
      <div>
        <dt><Copy en="Named tasks / profiles" zh="具名任务 / profiles" /></dt>
        <dd>{environmentTaskProfileCount}+</dd>
      </div>
      <div>
        <dt><Copy en="Distributions" zh="Distributions" /></dt>
        <dd>{environmentDistributionCount}</dd>
      </div>
      <div>
        <dt><Copy en="Ecosystems" zh="上游生态" /></dt>
        <dd>{environmentEcosystemCount}</dd>
      </div>
      <div>
        <dt><Copy en="Collections" zh="任务集合" /></dt>
        <dd>{environmentCollections.length}</dd>
      </div>
    </dl>
    <Copy
      class="environment-count-note"
      en="The count includes 50 canonical MetaWorld MT1 tasks plus MT10 and MT50. Parameterized custom MetaWorld collections and WFC size variants extend the concrete configuration surface beyond this fixed named count."
      zh="该数量包含 50 个标准 MetaWorld MT1 任务以及 MT10、MT50。参数化 MetaWorld custom 集合和 WFC 尺寸变体会使实际可配置空间超过这个固定具名数量。"
      as="p"
    />

    <div class="environment-domain-grid">
      {environmentDomains.map((domain) => (
        <article>
          <span>
            {String(domainTaskProfileCount(domain.id)).padStart(2, "0")}{" "}
            <Copy en="tasks / profiles" zh="任务 / profiles" />
          </span>
          <Copy en={domain.title.en} zh={domain.title.zh} as="h3" />
          <Copy en={domain.summary.en} zh={domain.summary.zh} as="p" />
        </article>
      ))}
    </div>
  </section>

  {catalogSections.map((section) => {
    const collections = collectionsFor(section);
    const distributions = collections.reduce(
      (total, collection) => total + collection.distributions,
      0,
    );
    const taskProfiles = collections.reduce(
      (total, collection) => total + collection.taskProfiles,
      0,
    );

    return (
      <section id={section.id}>
        <div class="environment-section-heading">
          <div>
            <Copy en={section.title.en} zh={section.title.zh} as="h2" />
            <Copy en={section.lead.en} zh={section.lead.zh} as="p" />
          </div>
          <span>
            {taskProfiles} <Copy en="tasks / profiles" zh="个任务 / profiles" />
            {" · "}
            {distributions} <Copy en="distributions" zh="个 distributions" />
          </span>
        </div>

        <table class="reference-table environment-comparison environment-catalog-table">
          <thead>
            <tr>
              <th><Copy en="Collection" zh="任务集合" /></th>
              <th><Copy en="Coverage" zh="覆盖" /></th>
              <th><Copy en="Policy interface" zh="Policy 接口" /></th>
              <th><Copy en="Primary measure" zh="主要指标" /></th>
              <th><Copy en="Environments and profiles" zh="环境与 profiles" /></th>
            </tr>
          </thead>
          <tbody>
            {collections.map((collection) => (
              <tr id={collection.id}>
                <td>
                  <strong>{collection.suite}</strong>
                  <small>{collection.ecosystem}</small>
                  <small>
                    <Copy en={collection.summary.en} zh={collection.summary.zh} />
                  </small>
                  <small>
                    <a
                      href={sourceUrl(collection)}
                      target="_blank"
                      rel="noreferrer"
                    >
                      <Copy en="Source ↗" zh="源码 ↗" />
                    </a>
                  </small>
                </td>
                <td>
                  <Copy en={collection.coverage.en} zh={collection.coverage.zh} />
                </td>
                <td>
                  <Copy
                    en={collection.policyInterface.en}
                    zh={collection.policyInterface.zh}
                  />
                </td>
                <td>
                  <Copy en={collection.score.en} zh={collection.score.zh} />
                </td>
                <td>
                  <div class="environment-table-items">
                    {collection.items.map((item) => (
                      item.path ? (
                        <a href={withBase(item.path)}>{item.name}</a>
                      ) : (
                        <span>{item.name}</span>
                      )
                    ))}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    );
  })}

  <section id="using">
    <Copy en="Using a distribution" zh="使用 distribution" as="h2" />
    <Copy
      en="Each leaf project owns its dependencies, Benchmark configuration, baseline Program, and tests. Select and build one project from the repository root:"
      zh="每个叶子 project 自行拥有依赖、Benchmark 配置、baseline Program 与测试。在仓库根目录选择并构建一个 project："
      as="p"
    />
    <pre><code>uv sync --project environments/gymnasium/classic_control/cartpole --extra dev
uv build environments/gymnasium/classic_control/cartpole</code></pre>
    <p class="reference-actions">
      <a
        href="https://github.com/Linzwcs/EvoPolicyGym/blob/main/environments/STATUS.md"
        target="_blank"
        rel="noreferrer"
      >
        <Copy en="Integration ledger ↗" zh="集成记录 ↗" />
      </a>
      <a href={withBase("docs/getting-started/")}>
        <Copy en="Getting started →" zh="快速开始 →" />
      </a>
    </p>
  </section>

  <section id="authoring">
    <Copy en="Authoring an environment" zh="编写环境" as="h2" />
    <Copy
      en="External distributions implement the Benchmark and Environment protocols through evopolicygym.authoring. The conformance suite covers configuration, Episode planning, Action validation, Feedback, failure semantics, and cleanup."
      zh="外部 distribution 通过 evopolicygym.authoring 实现 Benchmark 与 Environment protocols。Conformance suite 覆盖配置、Episode 规划、Action 校验、Feedback、失败语义与资源清理。"
      as="p"
    />
    <p>
      <a href={withBase("docs/authoring/")}>
        <Copy en="Read the authoring guide →" zh="阅读环境编写指南 →" />
      </a>
    </p>
  </section>
</ReferenceLayout>
