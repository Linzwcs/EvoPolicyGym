const toc = [
  { id: "organization", en: "Organization", zh: "组织方式" },
  ...suites.map((suite) => ({ id: suite.id, en: suite.name, zh: suite.name })),
  { id: "jackdaw", en: "Jackdaw / Balatro", zh: "Jackdaw / Balatro" },
  { id: "archive", en: "Research archive", zh: "研究档案" },
  { id: "authoring", en: "Authoring", zh: "编写环境" },
];

const suiteSource = (suite: EnvironmentSuite) =>
  `https://github.com/Linzwcs/EvoPolicyGym/tree/main/environments/gymnasium/${suite.directory}`;

const environmentSource = (environment: EnvironmentEntry) =>
  `https://github.com/Linzwcs/EvoPolicyGym/tree/main/environments/gymnasium/${environment.sourcePath}`;
---

<ReferenceLayout
  title="Environment Collection — EvoPolicyGym Documentation"
  description="The 23 current Gymnasium tasks, Balatro game Benchmark, and historical research environments available in EvoPolicyGym."
  current="environments"
  {toc}
>
  <header>
    <Copy en="Environment collection" zh="环境目录" as="h1" />
    <Copy
      class="reference-lead"
      en="Twenty-three current Gymnasium tasks and one long-horizon game Benchmark, organized by upstream ecosystem and suite."
      zh="23 个当前 Gymnasium 任务与 1 个长时程游戏 Benchmark，按照上游生态与任务套件组织。"
      as="p"
    />
  </header>

  <section id="organization">
    <Copy en="Organization" zh="组织方式" as="h2" />
    <Copy
      en="The portable Kernel contains no simulator. Every environment is an independently installable Benchmark distribution that owns its Policy interface, typed Environment parameters, deterministic Episode planning, scoring, public Feedback, baseline Program, dependency lock, and tests."
      zh="可移植 Kernel 不包含 simulator。每个环境都是可独立安装的 Benchmark distribution，自行拥有 Policy 接口、类型化 Environment 参数、确定性 Episode 规划、评分、公开 Feedback、baseline Program、依赖锁与测试。"
      as="p"
    />

    <div class="reference-tree" aria-label="Environment collection hierarchy">
      {suites.map((suite) => (
        <div>
          <strong>Gymnasium</strong>
          <span>{suite.name}</span>
          <Copy
            as="small"
            en={`${suite.environments.length} independent distributions`}
            zh={`${suite.environments.length} 个独立 distributions`}
          />
        </div>
      ))}
      <div>
        <strong>Jackdaw</strong>
        <span>Balatro</span>
        <Copy as="small" en="Red Deck · White Stake run" zh="Red Deck · White Stake run" />
      </div>
    </div>

    <div class="reference-note">
      <strong><Copy en="One task family, one distribution" zh="一个任务族，一个 distribution" /></strong>
      <Copy
        en="Registered variants such as FrozenLake8x8, CliffWalkingSlippery, LunarLanderContinuous, and BipedalWalkerHardcore are selected through typed configuration rather than duplicated as packages. Deprecated Gymnasium versions and experimental phys2d or tabular implementations are not separate Benchmarks."
        zh="FrozenLake8x8、CliffWalkingSlippery、LunarLanderContinuous 与 BipedalWalkerHardcore 等注册变体通过类型化配置选择，而不会复制成多个 package。已弃用的 Gymnasium 版本以及实验性的 phys2d、tabular 实现不单独作为 Benchmark。"
        as="p"
      />
    </div>
  </section>

  {suites.map((suite) => (
    <section id={suite.id}>
      <Copy en={`Gymnasium / ${suite.name}`} zh={`Gymnasium / ${suite.name}`} as="h2" />
      <Copy en={suite.summary.en} zh={suite.summary.zh} as="p" />

      <table class="reference-table environment-comparison">
        <thead>
          <tr>
            <th><Copy en="Environment" zh="环境" /></th>
            <th><Copy en="Policy observation" zh="Policy observation" /></th>
            <th><Copy en="Action" zh="Action" /></th>
            <th><Copy en="Episode limit" zh="Episode 上限" /></th>
            <th><Copy en="Primary score" zh="主要评分" /></th>
            <th><Copy en="Configuration" zh="环境参数" /></th>
          </tr>
        </thead>
        <tbody>
          {suite.environments.map((environment) => (
            <tr>
              <td>
                {environment.contractPath ? (
                  <a href={withBase(environment.contractPath)}><strong>{environment.name}</strong></a>
                ) : (
                  <strong>{environment.name}</strong>
                )}
                <small>{environment.benchmark}</small>
                <small><a href={environmentSource(environment)} target="_blank" rel="noreferrer">{environment.packageName} ↗</a></small>
              </td>
              <td><Copy en={environment.observation.en} zh={environment.observation.zh} /></td>
              <td><Copy en={environment.action.en} zh={environment.action.zh} /></td>
              <td>{environment.horizon}</td>
              <td><Copy en={environment.score.en} zh={environment.score.zh} /></td>
              <td><Copy en={environment.configuration.en} zh={environment.configuration.zh} /></td>
            </tr>
          ))}
        </tbody>
      </table>

      <p class="reference-actions">
        <a href={suiteSource(suite)} target="_blank" rel="noreferrer">
          <Copy en={`Browse ${suite.name} source ↗`} zh={`浏览 ${suite.name} 源码 ↗`} />
        </a>
      </p>
    </section>
  ))}

  <section id="jackdaw">
    <Copy en="Jackdaw / Balatro" zh="Jackdaw / Balatro" as="h2" />
    <Copy
      en="Balatro is kept separate from Gymnasium because it is a long-horizon game run powered by the pinned, vendored Jackdaw rules engine. The engine belongs to the Benchmark distribution, never to the portable Kernel."
      zh="Balatro 与 Gymnasium 分开组织：它是一局由锁定并 vendored 的 Jackdaw 规则引擎驱动的长时程游戏。该引擎属于 Benchmark distribution，而不属于可移植 Kernel。"
      as="p"
    />

    <table class="reference-table environment-comparison">
      <thead>
        <tr>
          <th><Copy en="Environment" zh="环境" /></th>
          <th><Copy en="Policy observation" zh="Policy observation" /></th>
          <th><Copy en="Action" zh="Action" /></th>
          <th><Copy en="Episode limit" zh="Episode 上限" /></th>
          <th><Copy en="Primary score" zh="主要评分" /></th>
          <th><Copy en="Configuration" zh="环境参数" /></th>
        </tr>
      </thead>
      <tbody>
        <tr id="balatro">
          <td>
            <strong>Red Deck · White Stake</strong>
            <small>Balatro standard run</small>
          </td>
          <td><Copy en="Named semantic dictionary of visible game state" zh="可见游戏状态的具名语义字典" /></td>
          <td><Copy en="Strict tagged dictionary with 21 Action kinds" zh="包含 21 种 Action kind 的严格 tagged 字典" /></td>
          <td><Copy en="2,048 decisions" zh="2,048 次决策" /></td>
          <td><Copy en="Mean run score; win bonus 1,000" zh="平均 run score；通关奖励 1,000" /></td>
          <td><Copy en="Deck, stake, content profile, optional Agent skill" zh="牌组、Stake、内容配置与可选 Agent skill" /></td>
        </tr>
      </tbody>
    </table>

