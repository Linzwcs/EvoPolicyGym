---
import BaseLayout from "../layouts/BaseLayout.astro";
import Copy from "../components/Copy.astro";
import { paperMeta, projectMeta } from "../data/project";
import { withBase } from "../lib/paths";
import "../styles/home.css";

const environmentFamilies = [
  {
    name: "Gymnasium",
    roleEn: "Control and planning",
    roleZh: "控制与规划",
    examples: "Classic Control · Toy Text · Box2D · MuJoCo · …",
  },
  {
    name: "MiniGrid & BabyAI",
    roleEn: "Navigation and language",
    roleZh: "导航与语言任务",
    examples: "MiniGrid families · WFC presets · BabyAI tasks · …",
  },
  {
    name: "Driving & Robotics",
    roleEn: "Structured and goal-conditioned control",
    roleZh: "结构化与目标条件控制",
    examples: "HighwayEnv · Gymnasium-Robotics · MetaWorld · …",
  },
  {
    name: "Games",
    roleEn: "Visual and long-horizon decisions",
    roleZh: "视觉与长时程决策",
    examples: "ALE · ViZDoom · Stable-Retro · Balatro · …",
  },
];
---

<BaseLayout
  title="EvoPolicyGym — Autonomous policy evolution"
  description="Open-source research software for evaluating autonomous Policy evolution in interactive Environments."
  bodyClass="home-page"
>
  <article class="academic-home">
    <header class="academic-intro page-wide">
      <div class="academic-intro-main">
        <p class="academic-label">
          <Copy
            en="Open-source research software for agent evaluation"
            zh="面向 Agent 评估的开源研究软件"
          />
        </p>
        <h1>EvoPolicyGym</h1>
        <Copy
          class="academic-deck"
          en="Evaluating autonomous Policy evolution in interactive Environments."
          zh="在交互式 Environment 中评估自主 Policy 演化。"
          as="p"
        />
        <Copy
          class="academic-abstract"
          en="EvoPolicyGym treats a coding agent as an optimizer of executable decision systems. Given a finite interaction budget, the agent authors a Program whose Policy is selected and then measured on held-out Cases after the agent has stopped running."
          zh="EvoPolicyGym 将 Coding Agent 视为可执行决策系统的优化器。Agent 在有限交互预算内编写 Program；Agent 停止运行后，系统选择其中一个 Policy，并在隐藏 Cases 上完成最终测量。"
          as="p"
        />
        <nav class="academic-links" aria-label="Project entry points">
          <a href={withBase("docs/getting-started/")}><Copy en="Get started" zh="快速开始" /> →</a>
          <a href={withBase("docs/")}><Copy en="Documentation" zh="文档" /></a>
          <a href={withBase("environments/")}><Copy en="Environments" zh="环境" /></a>
          <a href={paperMeta.url} target="_blank" rel="noreferrer"><Copy en="Paper" zh="论文" /> ↗</a>
        </nav>
      </div>

      <aside class="project-record" aria-label="Project record">
        <p><Copy en="Project record" zh="项目记录" /></p>
        <dl>
          <div>
            <dt><Copy en="Release" zh="版本" /></dt>
            <dd>{projectMeta.versionLabel} · <Copy en="active alpha" zh="活跃 Alpha" /></dd>
          </div>
          <div>
            <dt><Copy en="Policy interface" zh="Policy 接口" /></dt>
            <dd><code>{projectMeta.protocolVersion}</code></dd>
          </div>
          <div>
            <dt><Copy en="Paper experiments" zh="论文实验" /></dt>
            <dd>{paperMeta.experimentVersion}</dd>
          </div>
          <div>
            <dt><Copy en="Implementation" zh="实现" /></dt>
            <dd>Python 3.12</dd>
          </div>
          <div>
            <dt><Copy en="License" zh="许可证" /></dt>
            <dd>MIT</dd>
          </div>
        </dl>
        <a href="https://github.com/Linzwcs/EvoPolicyGym" target="_blank" rel="noreferrer">
          <Copy en="Source repository" zh="源代码仓库" /> ↗
        </a>
      </aside>
    </header>

    <div class="academic-columns page-wide">
      <section class="academic-section compact-section" aria-labelledby="quickstart-heading">
        <p class="academic-label">01 · <Copy en="Start here" zh="从这里开始" /></p>
        <Copy en="Quick start" zh="快速开始" as="h2" id="quickstart-heading" />
        <Copy
          en="Install the repository and evaluate the packaged CartPole baseline over five Episodes."
          zh="安装仓库，并在 5 个 Episodes 上评估 package 内置的 CartPole baseline。"
          as="p"
        />
        <pre><code>git clone https://github.com/Linzwcs/EvoPolicyGym
cd EvoPolicyGym
uv sync --project environments/gymnasium/classic_control/cartpole --extra dev
uv run --project environments/gymnasium/classic_control/cartpole \
  evopolicygym-cartpole evaluate --episodes 5 --allow-unsafe-process</code></pre>
        <a class="text-link" href={withBase("docs/getting-started/")}>
          <Copy en="Full installation and usage guide" zh="完整安装与使用指南" /> →
        </a>
      </section>

      <section class="academic-section compact-section" aria-labelledby="scope-heading">
        <p class="academic-label">02 · <Copy en="Gym-compatible environments" zh="Gym 兼容环境" /></p>
        <Copy en="Broad coverage across environment ecosystems." zh="覆盖广泛的环境生态。" as="h2" id="scope-heading" />
        <Copy
          en="EvoPolicyGym integrates Gymnasium and Gym-style ecosystems through explicit Benchmark distributions, spanning control, navigation, robotics, driving, and visual or long-horizon games."
          zh="EvoPolicyGym 通过显式 Benchmark distribution 接入 Gymnasium 与 Gym-style 生态，覆盖控制、导航、机器人、驾驶，以及视觉或长时程游戏。"
          as="p"
        />
        <table class="environment-summary">
          <thead>
            <tr>
              <th><Copy en="Family" zh="类型" /></th>
              <th><Copy en="Coverage" zh="覆盖方向" /></th>
              <th><Copy en="Examples" zh="示例" /></th>
            </tr>
          </thead>
          <tbody>
            {environmentFamilies.map((environment) => (
              <tr>
                <td>{environment.name}</td>
                <td><Copy en={environment.roleEn} zh={environment.roleZh} /></td>
                <td>{environment.examples}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <a class="text-link" href={withBase("environments/")}>
          <Copy en="View all environments and contracts" zh="查看全部环境与契约" /> →
        </a>
      </section>
    </div>

  </article>
</BaseLayout>
